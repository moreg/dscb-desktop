{
  "name": "ai-writer-desktop",
  "version": "0.1.7",
  "description": "大神持笔 桌面版（本地文件存储）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --publish never",
    "icon": "node scripts/generate-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:brainstorm-ui": "node scripts/brainstorm-ui-smoke.mjs",
    "style:baseline": "node scripts/style-baseline.mjs",
    "deslop:corpus": "vitest run tests/deslop-corpus.test.ts",
    "lint": "eslint src tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.aiwriter.desktop",
    "productName": "大神持笔 桌面版",
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "moreg",
      "repo": "dscb-desktop",
      "releaseType": "draft"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/skia-canvas/**/*",
      "node_modules/zod/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/skia-canvas/**/*"
    ],
    "win": {
      "artifactName": "dscb-desktop-setup-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skia-canvas": "^3.0.8",
    "zod": "^4.4.3"
  }
}
